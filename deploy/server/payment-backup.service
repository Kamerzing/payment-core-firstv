[Unit]
Description=Encrypted Payment Core PostgreSQL backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/payment-core/deploy/server
ExecStart=/usr/bin/flock -n /run/lock/payment-core-backup.lock /usr/bin/docker compose --env-file .env --profile ops run --rm --no-deps backup backup
TimeoutStartSec=2h
UMask=0077
